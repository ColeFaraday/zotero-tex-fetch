# Copy to `.env`.

ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /Applications/Zotero.app/Contents/MacOS/zotero

# The scaffold's default kill command on macOS is `kill -9 $(ps -x | grep zotero)`,
# which also kills your everyday Zotero. The scaffold kills its own child
# process anyway, so make the extra kill a no-op.
ZOTERO_PLUGIN_KILL_COMMAND = true
